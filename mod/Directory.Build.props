<Project>
  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <LangVersion>latestmajor</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />
  <PropertyGroup>
    <SaberRankWebsiteBaseUrl Condition="'$(SaberRankWebsiteBaseUrl)' == ''">https://YOUR-SABERRANK-API-DOMAIN</SaberRankWebsiteBaseUrl>
    <SaberRankApiBaseUrl Condition="'$(SaberRankApiBaseUrl)' == ''">https://YOUR-SABERRANK-API-DOMAIN</SaberRankApiBaseUrl>
    <SaberRankCdnBaseUrl Condition="'$(SaberRankCdnBaseUrl)' == ''">https://cdn.saberrank.local</SaberRankCdnBaseUrl>
    <SaberRankLudusUrl Condition="'$(SaberRankLudusUrl)' == ''">wss://ludus-1.saberrank.local/v1/connect</SaberRankLudusUrl>
  </PropertyGroup>
</Project>
