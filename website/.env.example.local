# Copy this to .env for local website development
# Leave blanks empty unless you need that integration

# Optional local fillins

# Patreon API clients: https://patreon.com/portal/registration/register-clients
# Access token/campaign ID: your creator/API client details
HOME_NEWS_PATREON_ACCESS_TOKEN=
HOME_NEWS_PATREON_CAMPAIGN_ID=

# X developer portal: https://developer.x.com/en/portal/dashboard
# Bearer token: your app > Keys and tokens
HOME_NEWS_X_BEARER_TOKEN=

# Google Cloud API credentials: https://console.cloud.google.com/apis/credentials
HOME_NEWS_YOUTUBE_API_KEY=

# Defaults / overrides
# These already come from config defaults
# Uncomment only when you intentionally want to override them

## Shared
# NODE_ENV=development

## Debug
# DEBUG_REACT_SCAN=false
# DEBUG_BREAKPOINTS=false
# DEBUG_PAGE_BACKGROUND=false

## API / public URLs
# API_URL=https://snoresaber.vercel.app
# NEXT_PUBLIC_API_URL=https://snoresaber.vercel.app
# NEXT_PUBLIC_SITE_URL=https://snoresaber.local
# NEXT_PUBLIC_ARCVIEWER_URL=https://snoresaber.vercel.app/watch
# NEXT_PUBLIC_LUDUS_URL=https://snoresaber.vercel.app

## Home news
# HOME_NEWS_X_USERNAME=SnoreSaber
# HOME_NEWS_YOUTUBE_HANDLE=@SnoreSaberOfficial

## Internal backend-owned
# VISITOR_RATE_LIMIT_SECRET=
